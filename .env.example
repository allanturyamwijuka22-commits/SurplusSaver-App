# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# SURPLUSSAVER PRODUCTION & SANDBOX CONFIGURATION (UGANDA / INTERNATIONAL)
# ============================================================================

# PAYMENT GATEWAY CONFIGURATION
# Supported modes: "sandbox" (explicitly labeled test mode) | "flutterwave" | "pesapal"
PAYMENT_PROVIDER_MODE="sandbox"

# Flutterwave (MTN Mobile Money Uganda, Airtel Money Uganda, Visa/Mastercard)
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET_HASH=""

# Pesapal v3 API (Uganda Mobile Money & Cards)
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""
PESAPAL_IPN_ID=""

# NOTIFICATIONS (Email & Uganda SMS Gateway)
# Leave empty in development to log notifications to in-app notification center with explicit setup status
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_FROM_EMAIL="no-reply@surplussaver.ug"
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""

# PLATFORM ECONOMICS & COMPLIANCE DEFAULTS
DEFAULT_CURRENCY="UGX"
DEFAULT_COMMISSION_BPS="1500"
RESERVATION_HOLD_MINUTES="15"
PDPO_UGANDA_DPO_EMAIL="privacy@surplussaver.ug"

